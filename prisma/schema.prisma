generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  name               String?
  role               UserRole            @default(USER)
  credits            Int                 @default(0)
  stripeCustomerId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tokens             BigInt              @default(100)
  Chat               Chat[]
  creditTransactions CreditTransaction[]
  Payment            Payment[]
  Project            Project[]
  subscriptions      Subscription[]
}

model SubscriptionPlan {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  priceMonthly    Float          @map("price_monthly")
  creditsPerMonth Int            @map("credits_per_month")
  features        Json?
  stripePriceId   String?        @map("stripe_price_id")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  subscriptions   Subscription[]
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  planId          String             @map("plan_id")
  status          SubscriptionStatus @default(ACTIVE)
  creditsPerMonth Int                @map("credits_per_month")
  stripeSubId     String?            @map("stripe_sub_id")
  startedAt       DateTime           @default(now()) @map("started_at")
  expiresAt       DateTime           @map("expires_at")
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditTransaction {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  amount      Int
  type        CreditType @map("type")
  description String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  stripeSessionId String?
  stripePaymentId String?  @map("stripe_payment_id")
  amount          Float
  currency        String   @default("eur")
  status          String   @default("pending")
  type            String
  creditsAmount   Int?     @map("credits_amount")
  metadata        Json?
  createdAt       DateTime @default(now())
  tokens          Int?     @default(0)
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Payment_user_id_fkey")

  @@index([userId], map: "Payment_user_id_idx")
  @@index([stripeSessionId], map: "Payment_stripe_session_id_idx")
}

model Project {
  id                       String                @id @default(cuid())
  userId                   String
  name                     String
  description              String?
  address                  String?
  municipality             String?
  departement              String?
  citycode                 String?
  coordinates              String?
  parcelIds                String                @default("") @map("parcel_ids")
  parcelArea               Float?                @map("parcel_area")
  parcelGeometry           String?               @map("parcel_geometry")
  parcelsGeoJSON           Json?                 @map("parcels_geojson")
  existingBuildingsData    Json?                 @map("existing_buildings_data")
  northAngle               Float?                @map("north_angle")
  processedSiteData        Json?                 @map("processed_site_data")
  status                   ProjectStatus         @default(DRAFT)
  projectType              String?               @map("project_type")
  authorizationType        String?               @map("authorization_type")
  authorizationExplanation String?               @map("authorization_explanation")
  projectDescription       Json?                 @map("project_description")
  paidAt                   DateTime?             @map("paid_at")
  pluAnalysisCount         Int                   @default(0) @map("plu_analysis_count")
  scale                    String                @default("1:100")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  category                 String?               @default("business") @db.VarChar(100)
  content                  Json?                 @default("{}")
  editor_data              Json?
  is_published             Boolean?              @default(false)
  subdomain                String?               @db.VarChar(100)
  thumbnail                String?
  descriptiveStatement     DescriptiveStatement?
  documents                Document[]
  elevationData            ElevationData[]
  feasibilityReport        FeasibilityReport?
  User                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Project_user_id_fkey")
  protectedAreas           ProtectedArea[]
  regulatoryAnalysis       RegulatoryAnalysis?
  sectionData              SectionData[]
  sitePlanData             SitePlanData?
  terrainData              TerrainData?

  @@index([userId])
}

model RegulatoryAnalysis {
  id             String   @id @default(cuid())
  projectId      String   @unique @map("project_id")
  zoneType       String?  @map("zone_type")
  pluDocumentId  String?  @map("plu_document_id")
  rawContent     String?  @map("raw_content")
  aiAnalysis     Json     @map("ai_analysis")
  constraints    Json?
  pdfUrl         String?  @map("pdf_url")
  protectedZones Json?    @map("protected_zones")
  analyzedAt     DateTime @default(now()) @map("analyzed_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProtectedArea {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  type        String
  name        String
  description String?
  distance    Float?
  constraints Json?
  sourceUrl   String?  @map("source_url")
  detectedAt  DateTime @default(now()) @map("detected_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model FeasibilityReport {
  id                String   @id @default(cuid())
  projectId         String   @unique @map("project_id")
  questionnaireData Json     @map("questionnaire_data")
  isFeasible        Boolean  @map("is_feasible")
  conditions        Json?
  adaptations       Json?
  report            String?
  generatedAt       DateTime @default(now()) @map("generated_at")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SitePlanData {
  id                 String   @id @default(cuid())
  projectId          String   @unique @map("project_id")
  canvasData         Json     @map("canvas_data")
  elements           Json?
  footprintExisting  Float?   @map("footprint_existing")
  footprintProjected Float?   @map("footprint_projected")
  footprintMax       Float?   @map("footprint_max")
  surfaceAreas       Json?    @map("surface_areas")
  vrdNetworks        Json?    @map("vrd_networks")
  northAngle         Float?   @map("north_angle")
  terrainData        Json?    @map("terrain_data")
  complianceResults  Json?    @map("compliance_results")
  building3D         Json?    @map("building_3d")
  updatedAt          DateTime @updatedAt @map("updated_at")
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TerrainData {
  id              String   @id @default(cuid())
  projectId       String   @unique @map("project_id")
  elevationPoints Json     @map("elevation_points")
  sectionLines    Json?    @map("section_lines")
  terrainModel    Json?    @map("terrain_model")
  profiles        Json?
  updatedAt       DateTime @updatedAt @map("updated_at")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ElevationData {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  facade      String
  wallHeights Json     @map("wall_heights")
  roofData    Json?    @map("roof_data")
  openings    Json?
  materials   Json?
  canvasData  Json?    @map("canvas_data")
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SectionData {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  name          String
  sectionLine   Json     @map("section_line")
  groundProfile Json?    @map("ground_profile")
  buildingCut   Json?    @map("building_cut")
  canvasData    Json?    @map("canvas_data")
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DescriptiveStatement {
  id            String   @id @default(cuid())
  projectId     String   @unique @map("project_id")
  answers       Json
  generatedText String?  @map("generated_text")
  sections      Json?
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  type        DocumentType @map("type")
  name        String
  fileUrl     String?      @map("file_url")
  fileData    String?      @map("file_data")
  metadata    Json?
  creditsUsed Int          @default(0) @map("credits_used")
  createdAt   DateTime     @default(now()) @map("created_at")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

model Chat {
  id        String   @id
  title     String   @default("New Chat")
  messages  Json     @default("[]")
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_chat_userid")
}

enum UserRole {
  USER
  DEVELOPER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum CreditType {
  PURCHASE
  SUBSCRIPTION
  PLU_ANALYSIS
  PLU_ANALYSIS_RELAUNCH
  PLAN_GENERATION
  VISUAL_GENERATION
  LANDSCAPE_INTEGRATION
  DOCUMENT_EXPORT
  DESCRIPTIVE_STATEMENT
  RENDERING_TRANSFORM
  RENDERING_PACK_PURCHASE
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum DocumentType {
  LOCATION_PLAN
  SITE_PLAN
  SECTION
  ELEVATION
  LANDSCAPE_INSERTION
  DESCRIPTIVE_STATEMENT
  FULL_PACKAGE
  RENDERING_TRANSFORM
}
